<% var maxDay = Math.max(1, ...(daily||[{views:0}]).map(function(d){return d.views})); %>
<% var totalPts = (daily||[]).reduce(function(a,d){return a+d.views},0); %>

<div class="dash-cards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-bottom:18px">
  <div class="dc"><div class="dc-icon s"><i class="fas fa-eye"></i></div><div><div class="dc-num"><%= (typeof month!=='undefined'?month:0).toLocaleString() %></div><div class="dc-lbl">Views · 30 days</div></div></div>
  <div class="dc"><div class="dc-icon"><i class="fas fa-user"></i></div><div><div class="dc-num"><%= (typeof uniqueVisitors!=='undefined'?uniqueVisitors:0).toLocaleString() %></div><div class="dc-lbl">Unique visitors · 30d</div></div></div>
  <div class="dc"><div class="dc-icon"><i class="fas fa-calendar-day"></i></div><div><div class="dc-num"><%= (typeof today!=='undefined'?today:0).toLocaleString() %></div><div class="dc-lbl">Views today</div></div></div>
  <div class="dc"><div class="dc-icon"><i class="fas fa-database"></i></div><div><div class="dc-num"><%= (typeof allTime!=='undefined'?allTime:0).toLocaleString() %></div><div class="dc-lbl">All-time views</div></div></div>
</div>

<div class="pnl">
  <div class="pnl-h"><h3><i class="fas fa-chart-line"></i> Traffic — last 14 days</h3><span class="badge on"><%= totalPts.toLocaleString() %> views</span></div>
  <div class="pnl-b">
    <% if(totalPts===0){ %>
      <div class="empty"><i class="fas fa-chart-line"></i><p>No visits recorded yet — data appears as people browse the site.</p></div>
    <% } else { var W=760,H=180,pad=24,n=daily.length,step=(W-pad*2)/(n-1);
       var pts=daily.map(function(d,i){var x=pad+i*step;var y=H-pad-(d.views/maxDay)*(H-pad*2);return [x,y];});
       var line=pts.map(function(p,i){return (i?'L':'M')+p[0].toFixed(1)+' '+p[1].toFixed(1)}).join(' ');
       var area=line+' L '+pts[n-1][0].toFixed(1)+' '+(H-pad)+' L '+pad+' '+(H-pad)+' Z'; %>
    <svg viewBox="0 0 <%= W %> <%= H %>" width="100%" height="200" preserveAspectRatio="none" style="overflow:visible">
      <defs><linearGradient id="ag" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="rgba(0,0,86,.28)"/><stop offset="100%" stop-color="rgba(0,0,86,0)"/></linearGradient></defs>
      <% for(var g=0;g<=4;g++){ var gy=pad+(H-pad*2)*g/4; %><line x1="<%=pad%>" y1="<%=gy%>" x2="<%=W-pad%>" y2="<%=gy%>" stroke="#eef0f6"/><% } %>
      <path d="<%= area %>" fill="url(#ag)"/>
      <path d="<%= line %>" fill="none" stroke="#000056" stroke-width="2.5" stroke-linejoin="round"/>
      <% pts.forEach(function(p,i){ %><circle cx="<%=p[0].toFixed(1)%>" cy="<%=p[1].toFixed(1)%>" r="<%= i===n-1?4:2.5 %>" fill="<%= i===n-1?'#e30000':'#000056' %>"><title><%= daily[i].date %>: <%= daily[i].views %> views</title></circle><% }) %>
    </svg>
    <div style="display:flex;justify-content:space-between;color:var(--muted,#94a3b8);font-size:.72rem;margin-top:4px"><span><%= daily[0].date.slice(5) %></span><span><%= daily[Math.floor(n/2)].date.slice(5) %></span><span><%= daily[n-1].date.slice(5) %></span></div>
    <% } %>
  </div>
</div>

<div style="display:grid;grid-template-columns:1.4fr 1fr;gap:16px" class="an-grid">
  <div class="pnl">
    <div class="pnl-h"><h3><i class="fas fa-fire"></i> Top pages · 30 days</h3><a class="fbtn o" href="/sacxc-cms/analytics/monthly.csv"><i class="fas fa-download"></i> CSV</a></div>
    <div class="pnl-b">
      <% var tp=(typeof topPages!=='undefined'?topPages:[]); var maxTP=Math.max(1,...tp.map(function(t){return t.views})); %>
      <% if(!tp.length){ %><div class="empty"><i class="fas fa-fire"></i><p>No page data yet</p></div><% } else { %>
        <div style="display:grid;gap:9px">
        <% tp.forEach(function(t){ var pct=Math.round(t.views/maxTP*100); %>
          <div style="display:grid;grid-template-columns:150px 1fr 46px;align-items:center;gap:10px;font-size:.82rem">
            <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--dark,#0f172a)"><%= t.page==='/'?'Home':t.page %></span>
            <span style="background:#eef0f6;border-radius:100px;height:10px;overflow:hidden"><span style="display:block;height:100%;width:<%=pct%>%;background:linear-gradient(90deg,#000056,#14237a)"></span></span>
            <span style="text-align:right;font-weight:700;color:var(--navy,#000056)"><%= t.views %></span>
          </div>
        <% }) %>
        </div>
      <% } %>
    </div>
  </div>
  <div class="pnl">
    <div class="pnl-h"><h3><i class="fas fa-arrows-split-up-and-left"></i> Traffic sources</h3></div>
    <div class="pnl-b">
      <% var src=(typeof sources!=='undefined'?sources:[]); var maxS=Math.max(1,...src.map(function(x){return x.c})); %>
      <% if(!src.length){ %><div class="empty"><i class="fas fa-arrows-split-up-and-left"></i><p>No source data yet</p></div><% } else { %>
        <div style="display:grid;gap:9px">
        <% src.forEach(function(x){ var pct=Math.round(x.c/maxS*100); var label=(x.src||'Direct').replace(/^https?:\/\//,'').split('/')[0]; %>
          <div style="display:grid;grid-template-columns:110px 1fr 40px;align-items:center;gap:10px;font-size:.82rem">
            <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= label %></span>
            <span style="background:#fdeaea;border-radius:100px;height:10px;overflow:hidden"><span style="display:block;height:100%;width:<%=pct%>%;background:linear-gradient(90deg,#e30000,#ff5a5a)"></span></span>
            <span style="text-align:right;font-weight:700;color:var(--red,#e30000)"><%= x.c %></span>
          </div>
        <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<div class="pnl">
  <div class="pnl-h"><h3><i class="fas fa-gauge-high"></i> At a glance</h3></div>
  <div class="pnl-b"><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px">
    <% Object.keys(contentHealth).forEach(function(k){ %>
      <div style="border:1px solid var(--border,#e2e8f0);border-radius:10px;padding:12px 14px"><div style="font-size:1.5rem;font-weight:800;color:var(--navy,#000056)"><%= contentHealth[k] %></div><div style="color:var(--muted,#64748b);font-size:.8rem"><%= k %></div></div>
    <% }) %>
  </div></div>
</div>
<style>.an-grid{}@media(max-width:820px){.an-grid{grid-template-columns:1fr!important}}
.dc{display:flex;align-items:center;gap:12px;background:#fff;border:1px solid var(--border,#e2e8f0);border-radius:12px;padding:14px 16px}
.dc-icon{width:42px;height:42px;border-radius:10px;background:#eef0fb;color:#000056;display:flex;align-items:center;justify-content:center;font-size:1rem}
.dc-icon.s{background:#000056;color:#fff}.dc-num{font-size:1.4rem;font-weight:800;color:var(--dark,#0f172a);line-height:1}.dc-lbl{color:var(--muted,#64748b);font-size:.78rem;margin-top:3px}</style>
