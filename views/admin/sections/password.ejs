<!-- PASSWORD -->
<div class="pnl">
  <div class="pnl-h"><h3><i class="fas fa-key"></i> Change Your Password</h3></div>
  <div class="pnl-b" style="max-width:500px">
    <form method="POST" action="/sacxc-cms/change-password">
      <div class="fg"><label>Current Password *</label><input type="password" name="current_password" required></div>
      <div class="fg"><label>New Password (min 12 characters) *</label><input type="password" name="new_password" minlength="12" required><small>Use a mix of upper/lowercase, numbers and symbols</small></div>
      <div class="fg"><label>Confirm New Password *</label><input type="password" name="confirm_password" minlength="12" required></div>
      <div class="factions">
        <button type="submit" class="fbtn g"><i class="fas fa-save"></i> Update Password</button>
      </div>
    </form>
  </div>
</div>

<div class="pnl">
  <div class="pnl-h"><h3><i class="fas fa-shield-halved"></i> Security Tips</h3></div>
  <div class="pnl-b">
    <ul style="padding-left:1.2rem;line-height:1.9;font-size:.88rem;color:var(--text)">
      <li>Use a password at least 12 characters long — the longer, the better.</li>
      <li>Combine UPPERCASE, lowercase, digits, and symbols (e.g. <code>!@#$%</code>).</li>
      <li>Never reuse passwords from other accounts.</li>
      <li>Don't share your login credentials with anyone, even other staff.</li>
      <li>Always sign out on shared or public computers.</li>
      <li>Report suspicious activity immediately to the Super Admin.</li>
    </ul>
  </div>
</div>
