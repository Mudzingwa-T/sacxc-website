<!-- MEMBER COMPANIES -->
<div class="pnl">
  <div class="pnl-h">
    <h3><i class="fas fa-building"></i> Member Organisations</h3>
    <button class="fbtn g" onclick="openItemModal(null)"><i class="fas fa-plus"></i> New Organisation</button>
  </div>
  <div class="pnl-b">
    <% if(!items || items.length===0){ %>
      <div class="empty"><i class="fas fa-building"></i><p>No organisations yet</p></div>
    <% } else { %>
      <div class="tbl-wrap"><table class="tbl">
        <thead><tr><th>Name</th><th>Sector</th><th>Order</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% items.forEach(c=>{ %>
            <tr>
              <td><strong><%= c.name %></strong></td>
              <td><span class="badge draft"><%= c.sector || 'Energy' %></span></td>
              <td><%= c.sort_order %></td>
              <td><span class="badge <%= c.active?'on':'off' %>"><%= c.active?'Active':'Hidden' %></span></td>
              <td><div class="ic-acts">
                <button class="be" onclick='openItemModal(<%- JSON.stringify(c).replace(/</g,"\\u003c") %>)'><i class="fas fa-edit"></i></button>
                <form method="POST" action="/sacxc-cms/companies/<%= c.id %>/delete" style="display:inline" onsubmit="return confirmDel('Delete organisation?')"><button class="bd" type="submit"><i class="fas fa-trash"></i></button></form>
              </div></td>
            </tr>
          <% }) %>
        </tbody>
      </table></div>
    <% } %>
  </div>
</div>

<div class="modal-back" id="itemModal">
  <div class="modal">
    <div class="modal-h"><h3 id="modalTitle">New Organisation</h3><button class="modal-x" onclick="closeItemModal()"><i class="fas fa-times"></i></button></div>
    <form id="itemForm" method="POST">
      <div class="modal-b">
        <div class="fg"><label>Name *</label><input type="text" name="name" id="f_name" required placeholder="ZESA Holdings"></div>
        <div class="fr">
          <div class="fg"><label>Sector</label><input type="text" name="sector" id="f_sector" placeholder="Energy" value="Energy"></div>
          <div class="fg"><label>Sort order</label><input type="number" name="sort_order" id="f_sort_order" value="1"></div>
        </div>
        <label class="chk-row"><input type="checkbox" name="active" id="f_active" value="1" checked> Active (visible on site)</label>
      </div>
      <div class="modal-f">
        <button type="button" class="fbtn o" onclick="closeItemModal()">Cancel</button>
        <button type="submit" class="fbtn g"><i class="fas fa-save"></i> Save</button>
      </div>
    </form>
  </div>
</div>

<script>
function openItemModal(it){
  document.getElementById('modalTitle').textContent=it?'Edit Organisation':'New Organisation';
  document.getElementById('f_name').value=it?it.name:'';
  document.getElementById('f_sector').value=it?(it.sector||'Energy'):'Energy';
  document.getElementById('f_sort_order').value=it?it.sort_order:1;
  document.getElementById('f_active').checked=it?!!it.active:true;
  document.getElementById('itemForm').action=it?'/sacxc-cms/companies/'+it.id:'/sacxc-cms/companies';
  document.getElementById('itemModal').classList.add('open');
}
function closeItemModal(){document.getElementById('itemModal').classList.remove('open')}
document.getElementById('itemModal').addEventListener('click',e=>{if(e.target.id==='itemModal')closeItemModal()});
</script>
