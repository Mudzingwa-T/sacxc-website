<%- include('../partials/header', { pageTitle: 'About Us', pageDesc: "About the Southern Africa Customer Experience Council (SACXC) — a member-governed regional council uniting CX associations and training institutes across all 16 SADC states." }) %>
<section class="page-hero" style="background-image:url('/images/page/network.jpg')"><div class="container"><span class="tag tag-light">About the Council</span><h1>Who We Are</h1><p>A regional council — not a regulator, not a competitor to its members — uniting CX associations and professional training institutes from across the SADC region.</p></div></section>

<section class="section"><div class="container">
  <div class="section-head left" id="team"><span class="tag">Overview</span><h2>One regional council for Southern Africa's CX community</h2></div>
  <p class="lead-text"><%= (content && content['about.who_body']) || data.site.about %></p>
</div></section>

<section class="section section-gray" id="vision"><div class="container">
  <div class="two-grid" style="gap:2rem">
    <div class="info-card"><div class="ac-icon"><i class="fas fa-eye"></i></div><h3>Our Vision</h3><p><%= data.site.vision %></p></div>
    <div class="info-card"><div class="ac-icon"><i class="fas fa-bullseye"></i></div><h3>Our Mission</h3><p><%= data.site.mission %></p></div>
  </div>
  <div class="text-center mt-3"><p class="lead-text" style="font-style:italic;color:var(--navy)">"<%= data.site.tagline %>"</p></div>
</div></section>

<section class="section" id="values"><div class="container">
  <div class="section-head"><span class="tag">Guiding Principles</span><h2>Our Core Values</h2></div>
  <div class="four-grid">
    <% data.values.forEach(function(v,i){ %><div class="principle"><span class="p-num"><%= String(i+1).padStart(2,'0') %></span><h4><%= v[0] %></h4><p><%= v[1] %></p></div><% }) %>
  </div>
</div></section>

<section class="section section-gray"><div class="container">
  <div class="section-head"><span class="tag">Our Mandate</span><h2>What the Council is working to achieve</h2></div>
  <div class="steps-grid">
    <% data.objectives.forEach(function(o,i){ %><div class="step-card"><div class="step-num"><%= i+1 %></div><h3><%= o.title %></h3><p><%= o.description %></p></div><% }) %>
  </div>
</div></section>

<section class="stats-bar"><div class="container stats-grid">
  <% data.stats.forEach(function(s){ %><div class="stat-item"><div class="stat-num"><%= s.n %></div><div class="stat-label"><%= s.label %></div></div><% }) %>
</div></section>
<%- include('../partials/footer') %>
