<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#0a1a6e">
  <%
    var _site  = (typeof data !== 'undefined' && data && data.site) ? data.site : {};
    var _title = (typeof pageTitle !== 'undefined' ? pageTitle + ' – ' : '') + (_site.name || 'SACXC') + ' – ' + (_site.fullName || 'Southern Africa Customer Experience Council');
    var _desc  = (typeof pageDesc !== 'undefined' && pageDesc) ? pageDesc : (_site.description || '');
    _desc = String(_desc).replace(/\s+/g,' ').trim().substring(0,160);
    var _path  = (typeof currentPath !== 'undefined' ? currentPath : '/');
    var _og    = (typeof ogImage !== 'undefined' && ogImage) ? ogImage : '/images/hero-2.jpg';
    var _base  = 'https://sacxc.org';
    var _canon = _base + (_path === '/' ? '' : _path);
    if (String(_og).indexOf('http') !== 0) _og = _base + _og;
    var _menu  = (typeof menu !== 'undefined' && menu && menu.length) ? menu : [
      {label:'Home',url:'/'},{label:'About',url:'/about'},{label:'Membership',url:'/membership'},{label:'Services',url:'/services'},
      {label:'Our Members',url:'/our-members'},{label:'Governance',url:'/governance'},{label:'ACXCO',url:'/acxco'},{label:'Get Involved',url:'/get-involved'}
    ];
  %>
  <title><%= _title %></title>
  <meta name="description" content="<%= _desc %>">
  <link rel="canonical" href="<%= _canon %>">
  <meta name="keywords" content="customer experience, CX, SADC, Southern Africa, customer experience council, CX standards, accreditation, ACXCO, professional membership">
  <meta name="author" content="<%= _site.fullName || 'SACXC' %>">
  <meta name="robots" content="index, follow, max-image-preview:large">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= _site.name || 'SACXC' %>">
  <meta property="og:title" content="<%= _title %>">
  <meta property="og:description" content="<%= _desc %>">
  <meta property="og:url" content="<%= _canon %>">
  <meta property="og:image" content="<%= _og %>">
  <meta property="og:locale" content="en_ZA">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= _title %>">
  <meta name="twitter:description" content="<%= _desc %>">
  <meta name="twitter:image" content="<%= _og %>">

  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="apple-touch-icon" href="/images/favicon.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/vendor/fa/webfonts/fa-solid-900.woff2" crossorigin>
  <% if (typeof preloadImage !== 'undefined' && preloadImage) { %><link rel="preload" as="image" href="<%= preloadImage %>" fetchpriority="high"><% } %>

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/vendor/flags/css/flag-icons.min.css">
  <link rel="stylesheet" media="print" onload="this.media='all'"
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap">
  <link rel="stylesheet" media="print" onload="this.media='all'" href="/vendor/fa/css/all.min.css">
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="/vendor/fa/css/all.min.css">
  </noscript>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "<%= _site.fullName || 'Southern Africa Customer Experience Council' %>",
    "alternateName": "SACXC",
    "url": "https://sacxc.org",
    "logo": "https://sacxc.org/images/sacxc-logo.png",
    "slogan": "<%= _site.tagline || '' %>",
    "email": "<%= _site.email || '' %>",
    "foundingLocation": "Gaborone, Botswana",
    "areaServed": "Southern African Development Community (SADC)",
    "memberOf": { "@type": "Organization", "name": "African Council of Customer Experience Organizations (ACXCO)" }
  }
  </script>
  <script type="application/ld+json">
  { "@context":"https://schema.org","@type":"WebSite","name":"SACXC","url":"<%= _base %>","inLanguage":"en" }
  </script>
  <script type="application/ld+json">
  { "@context":"https://schema.org","@type":"WebPage","name":"<%= _title %>","description":"<%= _desc %>","url":"<%= _canon %>","isPartOf":{"@type":"WebSite","name":"SACXC","url":"<%= _base %>"} }
  </script>
</head>
<body>
  <div class="topbar-red">
    <div class="container topbar-inner">
      <div class="topbar-left">
        <% if (_site.phone) { %><a href="tel:<%= _site.phone %>"><i class="fas fa-phone-alt"></i> <%= _site.phone %></a><% } %>
        <% if (_site.email) { %><a href="mailto:<%= _site.email %>"><i class="fas fa-envelope"></i> <%= _site.email %></a><% } %>
        <span style="opacity:.9"><i class="fas fa-location-dot"></i> Gaborone, Botswana</span>
      </div>
      <div class="topbar-right"><span><%= _site.tagline || 'One Region. One Standard. One Customer Experience.' %></span></div>
    </div>
  </div>

  <nav class="navbar" id="navbar">
    <div class="container nav-inner">
      <a href="/" class="logo logo--wordmark">
        <img src="/images/sacxc-logo.png" alt="Southern Africa Customer Experience Council" class="logo-img">
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Menu"><span></span><span></span><span></span></button>
      <ul class="nav-links" id="navLinks">
        <% _menu.forEach(function(m, i){ var last = (i === _menu.length - 1); %>
          <% if (last) { %><li><a href="<%= m.url %>" class="btn-nav"><%= m.label %></a></li>
          <% } else { %><li><a href="<%= m.url %>" class="<%= _path === m.url ? 'active' : '' %>"><%= m.label %></a></li><% } %>
        <% }) %>
      </ul>
    </div>
  </nav>

  <% var _tick = (typeof data !== 'undefined' && data && Array.isArray(data.ticker)) ? data.ticker.filter(function(t){return t && t.active !== false && t.text;}) : []; %>
  <% if (_tick.length) { %>
  <div class="news-ticker" role="region" aria-label="Latest news">
    <div class="news-ticker-label"><i class="fas fa-bolt"></i> <span>Latest</span></div>
    <div class="news-ticker-viewport">
      <div class="news-ticker-track">
        <% for (var _rep = 0; _rep < 2; _rep++) { %>
          <% _tick.forEach(function(t){ %>
            <span class="news-ticker-item" <%= _rep===1 ? 'aria-hidden="true"' : '' %>>
              <i class="fas fa-circle news-ticker-dot"></i>
              <% if (t.link) { %><a href="<%= t.link %>"><%= t.text %></a><% } else { %><%= t.text %><% } %>
            </span>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>
  <% } %>
